\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Overview of the green analytical strategy for equivalence point (EQP) determination in potentiometric titrations, demonstrated for TRIS (0.1\,M) titrated with \ce {HCl} (0.1\,M). Left: a) pH vs. titrant volume ($V$) curve from the initial titration (full run to post-EQP*). b) Schwartz--Gran modified plot ($V \times 10^{-\mathrm  {pH}}$ vs. $V$), showing the straight pre-EQP* line extrapolated to the EQP* (dashed line; intercept at 5.005\,mL). Right: c) Titration performed up to the optimal earliest acceptable point volume (4.40\,mL in this case). d) Corresponding Schwartz--Green modified plot confirming EQP extrapolation (intercept at 5.002\,mL) with reduced dispensed titrant volume.\relax }}{3}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:titrations}{{1}{3}{Overview of the green analytical strategy for equivalence point (EQP) determination in potentiometric titrations, demonstrated for TRIS (0.1\,M) titrated with \ce {HCl} (0.1\,M). Left: a) pH vs. titrant volume ($V$) curve from the initial titration (full run to post-EQP*). b) Schwartz--Gran modified plot ($V \times 10^{-\mathrm {pH}}$ vs. $V$), showing the straight pre-EQP* line extrapolated to the EQP* (dashed line; intercept at 5.005\,mL). Right: c) Titration performed up to the optimal earliest acceptable point volume (4.40\,mL in this case). d) Corresponding Schwartz--Green modified plot confirming EQP extrapolation (intercept at 5.002\,mL) with reduced dispensed titrant volume.\relax }{figure.caption.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Gran--Schwartz results for the \ce {TRIS}/\ce {HCl} system in the vicinity of the optimal volume $V_{\rm  opt}$ (4.40\,mL, in bold). Full titration EQP* corresponds to 5.005\,mL. The selected volume meets the acceptance criteria of deviation from reference EQP* smaller than 0.010\,mL) with excellent linearity and low uncertainty. Except for R$^2$, all values in\,mL\relax }}{3}{table.caption.2}\protected@file@percent }
\newlabel{tab:trimming}{{1}{3}{Gran--Schwartz results for the \ce {TRIS}/\ce {HCl} system in the vicinity of the optimal volume $V_{\rm opt}$ (4.40\,mL, in bold). Full titration EQP* corresponds to 5.005\,mL. The selected volume meets the acceptance criteria of deviation from reference EQP* smaller than 0.010\,mL) with excellent linearity and low uncertainty. Except for R$^2$, all values in\,mL\relax }{table.caption.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Comparison between a) EQP*-determination by Gran--Schwartz linear interpolation on the full titration curve, and b) Gran--Schwartz linear extrapolation to determine the EQP. The titration is stopped at the optimal volume \(V_{\rm  opt}\) corresponding to the indicated deviation from reference EQP* (see \(V_{\rm  opt}\) values in text) Results are mean $\pm $ SD ($n=6$ replicates). All values are in\,mL.\relax }}{3}{table.caption.3}\protected@file@percent }
\newlabel{tab:validation}{{2}{3}{Comparison between a) EQP*-determination by Gran--Schwartz linear interpolation on the full titration curve, and b) Gran--Schwartz linear extrapolation to determine the EQP. The titration is stopped at the optimal volume \(V_{\rm opt}\) corresponding to the indicated deviation from reference EQP* (see \(V_{\rm opt}\) values in text) Results are mean $\pm $ SD ($n=6$ replicates). All values are in\,mL.\relax }{table.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Reagent savings achieved by stopping at \(V_{\rm  opt}\) using different acceptance thresholds (0.010, 0.020 and 0.050\,mL difference from EQP*). Results are shown for both \ce {TRIS}/\ce {HCl} and \ce {KHP}/\ce {NaOH} systems ($n=6$ replicates each) and compared against the equivalence point\relax }}{4}{figure.caption.4}\protected@file@percent }
\newlabel{fig:volume_savings}{{2}{4}{Reagent savings achieved by stopping at \(V_{\rm opt}\) using different acceptance thresholds (0.010, 0.020 and 0.050\,mL difference from EQP*). Results are shown for both \ce {TRIS}/\ce {HCl} and \ce {KHP}/\ce {NaOH} systems ($n=6$ replicates each) and compared against the equivalence point\relax }{figure.caption.4}{}}
