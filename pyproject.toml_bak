[build-system]
requires = ["setuptools>=45", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "granted"
version = "0.9.2"
description = "GranTED: Gran/Schwartz Titration Analysis Tool"
readme = "README.md"
requires-python = ">=3.8"
license = {text = "Apache-2.0"}
authors = [
    {name = "Samuele Giani"}
]
keywords = ["titration", "gran", "schwartz", "analytical-chemistry", "potentiometry"]

dependencies = [
    "numpy>=1.21",
    "pandas>=1.3",
    "scipy>=1.7",
    "matplotlib>=3.5",
    "seaborn>=0.11",
]

[project.scripts]
granted = "granted.main:main"

[tool.setuptools.packages.find]
where = ["src"]
namespaces = false
